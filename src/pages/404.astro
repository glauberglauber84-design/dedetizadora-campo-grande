---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/siteConfig';

const title = `Página não encontrada — ${siteConfig.nome}`;
const description = `A página que você procura não existe. Volte para o início ou fale pelo WhatsApp ${siteConfig.whatsapp}.`;
---
<BaseLayout title={title} description={description} canonical="/404" noindex={true}>
  <section class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center px-4 py-16 text-center sm:px-6">
    <p class="text-xs font-semibold uppercase tracking-widest text-primary-900">Erro 404</p>
    <h1 class="mt-3 text-4xl font-extrabold text-slate-900 sm:text-5xl">Página não encontrada</h1>
    <p class="mt-4 max-w-prose text-base leading-relaxed text-slate-700">
      O link que você acessou pode ter sido movido ou não existe mais. Mas podemos te ajudar agora mesmo.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href="/"
        class="inline-flex min-h-12 items-center justify-center rounded-md bg-primary-900 px-6 py-3 text-base font-bold text-white shadow transition duration-200 ease-out hover:-translate-y-0.5 hover:bg-primary-800 hover:shadow-lg motion-reduce:transform-none"
      >
        Voltar para o início
      </a>
      <a
        href={siteConfig.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-12 items-center justify-center rounded-md border-2 border-primary-900 px-6 py-3 text-base font-semibold text-primary-900 transition duration-200 ease-out hover:bg-primary-50"
      >
        Falar no WhatsApp
      </a>
    </div>
  </section>
</BaseLayout>
