---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Sobre from '../components/Sobre.astro';
import ComoEncontrar from '../components/ComoEncontrar.astro';
import Contato from '../components/Contato.astro';
import { siteConfig } from '../config/siteConfig';

const title = `Sobre a ${siteConfig.nome} — equipe, licenças e atendimento`;
const description = `Conheça a ${siteConfig.nome}: mais de 10 anos atuando com controle de pragas em Campo Grande/MS. Equipe certificada, produtos registrados Anvisa e garantia escrita.`;
---
<BaseLayout title={title} description={description} canonical="/sobre">
  <Hero
    h1={`Sobre a ${siteConfig.nome}`}
    subtitle="Mais de uma década cuidando da saúde de famílias, comércios e condomínios em Campo Grande e região."
    cidade="Campo Grande"
  />

  <Sobre texto={`Fundada por técnicos sanitaristas com experiência em grandes centros, a ${siteConfig.nome} nasceu com um objetivo claro: oferecer controle de pragas sério, previsível e seguro — sem improviso e sem química de origem duvidosa.

Trabalhamos lado a lado com clientes residenciais, restaurantes, escolas, condomínios e indústrias. Cada atendimento começa por uma vistoria técnica, segue um plano por escrito e termina com garantia formal. Simples assim, do jeito que todo serviço de dedetização deveria ser.`} />

  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
    <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Nossos compromissos</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      <li class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="text-xl font-semibold text-primary-900">Transparência</h3>
        <p class="mt-2 text-base text-slate-700">Orçamento sem letras miúdas, com descrição do serviço, prazo e garantia.</p>
      </li>
      <li class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="text-xl font-semibold text-primary-900">Segurança</h3>
        <p class="mt-2 text-base text-slate-700">Produtos registrados na Anvisa e protocolo pet-friendly quando aplicável.</p>
      </li>
      <li class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="text-xl font-semibold text-primary-900">Pontualidade</h3>
        <p class="mt-2 text-base text-slate-700">Horário combinado é horário cumprido. Sem reagendamento sem motivo.</p>
      </li>
      <li class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="text-xl font-semibold text-primary-900">Responsabilidade ambiental</h3>
        <p class="mt-2 text-base text-slate-700">Destinação correta de resíduos e manejo integrado de pragas (MIP).</p>
      </li>
    </ul>
  </section>

  <ComoEncontrar cidade="Campo Grande" />
  <Contato />
</BaseLayout>
