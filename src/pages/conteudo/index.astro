---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Contato from '../../components/Contato.astro';
import { siteConfig } from '../../config/siteConfig';

const todos = await getCollection('artigos', ({ data }) => !data.draft);
const artigos = todos.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const title = `Conteúdo — guias e dicas sobre controle de pragas em Campo Grande`;
const description = `Guias práticos sobre cupim, baratas, ratos, mosquitos e prevenção, escritos pela equipe da ${siteConfig.nome}.`;

const categoriaLabel: Record<string, string> = {
  cupim: 'Cupim',
  baratas: 'Baratas',
  ratos: 'Ratos',
  mosquitos: 'Mosquitos',
  escorpioes: 'Escorpiões',
  formigas: 'Formigas',
  prevencao: 'Prevenção',
  geral: 'Geral',
};

const categoriaImagem: Record<string, string> = {
  cupim: '/images/cupim.jpg',
  baratas: '/images/baratas.jpg',
  ratos: '/images/ratos.jpg',
  escorpioes: '/images/escorpiao.jpg',
  formigas: '/images/formigas.jpg',
  mosquitos: '/images/hero-dedetizacao.jpg',
  prevencao: '/images/hero-dedetizacao.jpg',
  geral: '/images/hero-dedetizacao.jpg',
};

const dateFmt = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
---
<BaseLayout title={title} description={description} canonical="/conteudo">
  <Hero
    h1="Conteúdo e guias práticos"
    subtitle="Artigos escritos pela nossa equipe técnica — do que o morador faz sozinho ao que precisa de técnico."
    cidade="Campo Grande"
  />

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    {artigos.length === 0 ? (
      <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-12 text-center">
        <h2 class="text-2xl font-bold text-slate-900">Primeiros artigos chegando em breve</h2>
        <p class="mx-auto mt-3 max-w-2xl text-base text-slate-700">
          Estamos preparando guias sobre cupim, baratas, ratos, mosquitos e prevenção. Enquanto isso, qualquer dúvida fale com a gente no WhatsApp.
        </p>
        <a
          href={siteConfig.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex min-h-11 items-center gap-2 rounded-md bg-primary-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-primary-800"
        >
          Falar no WhatsApp
        </a>
      </div>
    ) : (
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {artigos.map((artigo) => (
          <li>
            <a
              href={`/conteudo/${artigo.slug}`}
              class="flex h-full flex-col overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm transition duration-200 ease-out hover:-translate-y-0.5 hover:border-primary-300 hover:shadow-md motion-reduce:transform-none"
            >
              <img
                src={categoriaImagem[artigo.data.categoria]}
                alt={`${categoriaLabel[artigo.data.categoria]} — ${artigo.data.title}`}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover"
              />
              <div class="flex flex-1 flex-col p-6">
                <span class="inline-flex w-fit items-center rounded-full bg-primary-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary-900">
                  {categoriaLabel[artigo.data.categoria]}
                </span>
                <h2 class="mt-3 text-xl font-semibold text-slate-900">{artigo.data.title}</h2>
                <p class="mt-2 flex-1 text-base text-slate-700">{artigo.data.description}</p>
                <div class="mt-4 flex items-center justify-between text-xs text-slate-500">
                  <time datetime={artigo.data.pubDate.toISOString()}>
                    {dateFmt.format(artigo.data.pubDate)}
                  </time>
                  <span class="inline-flex items-center font-semibold text-primary-900">
                    Ler artigo
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="ml-1 h-4 w-4" aria-hidden="true">
                      <path d="M9 6l6 6-6 6V6z"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <Contato />
</BaseLayout>
