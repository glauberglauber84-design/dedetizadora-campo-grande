---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ComoEncontrar from '../components/ComoEncontrar.astro';
import Contato from '../components/Contato.astro';
import { siteConfig } from '../config/siteConfig';

const title = `Serviços — ${siteConfig.nome} em Campo Grande e região`;
const description = `Dedetização, descupinização, desratização, controle de mosquitos e sanitização em Campo Grande, Sidrolândia, Terenos, Nova Almeida e Jaraguari.`;
const cidadePrincipal = siteConfig.cidades[0];
---
<BaseLayout title={title} description={description} canonical="/servicos">
  <Hero
    h1="Nossos serviços de controle de pragas"
    subtitle="Nove frentes de atendimento, cinco cidades. Escolha o serviço e peça orçamento no WhatsApp."
    cidade={cidadePrincipal.label}
    backgroundImage="/images/hero-dedetizacao.jpg"
    imageAlt="Técnico da Dedetizadora Campo Grande em atendimento residencial"
  />

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16" id="servicos">
    <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">O que a {siteConfig.nome} faz</h2>
    <p class="mt-4 max-w-3xl text-base text-slate-700">
      Cada serviço começa por uma vistoria técnica, segue um plano escrito e termina com garantia formal. Clique no serviço para ver detalhes da sua cidade.
    </p>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {siteConfig.servicos.map((servico) => (
        <li>
          <a
            href={`/${servico.slug}/${cidadePrincipal.slug}`}
            class="group flex h-full flex-col overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm transition duration-200 ease-out hover:-translate-y-0.5 hover:border-primary-300 hover:shadow-md motion-reduce:transform-none"
          >
            {servico.imagem ? (
              <img
                src={servico.imagem}
                alt={`${servico.label} — ${siteConfig.nome}`}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover"
              />
            ) : (
              <div class="flex aspect-[4/3] w-full items-center justify-center bg-primary-50">
                <span aria-hidden="true" class="text-6xl text-primary-900">{servico.icone}</span>
              </div>
            )}
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-xl font-semibold text-primary-900">{servico.label}</h3>
              <p class="mt-2 flex-1 text-base text-slate-700">{servico.descricao}</p>
              <span class="mt-4 inline-flex items-center text-sm font-semibold text-primary-900">
                Ver detalhes
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="ml-1 h-4 w-4" aria-hidden="true">
                  <path d="M9 6l6 6-6 6V6z"/>
                </svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-primary-50/50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Cidades atendidas</h2>
      <p class="mt-4 max-w-3xl text-base text-slate-700">
        Atendemos Campo Grande e a região metropolitana. Clique na cidade para ver a página do serviço principal.
      </p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {siteConfig.cidades.map((cidade) => (
          <li>
            <a
              href={`/dedetizacao-residencial/${cidade.slug}`}
              class="flex min-h-11 items-center justify-between rounded-md border border-slate-200 bg-white px-4 py-3 text-base font-medium text-slate-900 transition-colors hover:border-primary-300 hover:text-primary-900"
            >
              <span>{cidade.label}</span>
              <span aria-hidden="true" class="text-primary-700">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ComoEncontrar cidade={cidadePrincipal.label} />
  <Contato />
</BaseLayout>
