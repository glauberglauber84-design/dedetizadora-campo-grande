---
import { siteConfig } from '../config/siteConfig';

interface Props {
  cidade?: string;
  titulo?: string;
}

const { cidade = 'campo-grande', titulo = 'Nossos Serviços' } = Astro.props;
---
<section id="servicos" class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
  <div class="mx-auto max-w-prose text-center">
    <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">{titulo}</h2>
    <p class="mt-4 text-base text-slate-700">
      Soluções profissionais de controle de pragas para residências, comércios e condomínios.
      Vistoria sem compromisso e produtos registrados.
    </p>
  </div>

  <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {siteConfig.servicos.map((servico) => (
      <li>
        <a
          href={`/${servico.slug}/${cidade}`}
          class="group flex h-full flex-col overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm transition duration-200 ease-out hover:-translate-y-0.5 hover:border-primary-300 hover:shadow-md motion-reduce:transform-none"
        >
          {servico.imagem ? (
            <img
              src={servico.imagem}
              alt={`${servico.label} — ${siteConfig.nome}`}
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] w-full object-cover"
            />
          ) : (
            <div class="flex aspect-[4/3] w-full items-center justify-center bg-primary-50">
              <span aria-hidden="true" class="text-6xl text-primary-900">{servico.icone}</span>
            </div>
          )}
          <div class="flex flex-1 flex-col p-5">
            <h3 class="text-xl font-semibold text-slate-900 group-hover:text-primary-900">
              {servico.label}
            </h3>
            <p class="mt-2 flex-1 text-sm text-slate-700">{servico.descricao}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary-900">
              Saiba mais
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 transition duration-200 ease-out group-hover:translate-x-0.5 motion-reduce:transform-none">
                <path d="M7.72 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.19 10 7.72 6.28a.75.75 0 0 1 0-1.06Z"/>
              </svg>
            </span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
