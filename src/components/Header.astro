---
import { siteConfig } from '../config/siteConfig';

const currentPath = Astro.url.pathname;
---
<header class="sticky top-0 z-40 w-full border-b border-primary-100 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2 text-primary-900 no-underline" aria-label={`${siteConfig.nome} — ir para a página inicial`}>
      <span aria-hidden="true" class="inline-flex h-10 w-10 items-center justify-center rounded-md bg-primary-900 text-white">
        <!-- Shield / pest icon -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true">
          <path d="M12 2 4 5v6c0 5 3.4 9.3 8 11 4.6-1.7 8-6 8-11V5l-8-3Zm-1 14-4-4 1.4-1.4L11 13.2l5.6-5.6L18 9l-7 7Z"/>
        </svg>
      </span>
      <span class="flex flex-col leading-tight">
        <span class="text-base font-bold sm:text-lg">Dedetizadora</span>
        <span class="text-xs font-medium text-primary-700 sm:text-sm">Campo Grande</span>
      </span>
    </a>

    <nav aria-label="Menu principal" class="hidden md:block">
      <ul class="flex items-center gap-6">
        {siteConfig.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "inline-flex min-h-11 items-center text-sm font-medium transition-colors",
                currentPath === item.href
                  ? "text-primary-900 underline underline-offset-4"
                  : "text-slate-700 hover:text-primary-900"
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href={siteConfig.whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Falar no WhatsApp ${siteConfig.whatsapp}`}
      class="inline-flex min-h-11 items-center gap-2 rounded-md bg-primary-900 px-4 py-2 text-sm font-semibold text-white shadow-sm transition duration-200 ease-out hover:-translate-y-0.5 hover:bg-primary-800 hover:shadow-md motion-reduce:transform-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
        <path d="M20.5 3.5A11 11 0 0 0 3.4 17.3L2 22l4.9-1.3a11 11 0 0 0 16.5-9.5 10.9 10.9 0 0 0-2.9-7.7Zm-8.5 17a9 9 0 0 1-4.6-1.3l-.3-.2-2.9.8.8-2.8-.2-.3A9 9 0 1 1 12 20.5Zm5.2-6.7c-.3-.1-1.7-.8-1.9-.9-.3-.1-.5-.1-.7.1-.2.3-.8.9-1 1.1-.2.2-.4.2-.6.1a7 7 0 0 1-3.6-3.2c-.3-.5.3-.4.7-1.3.1-.2 0-.4 0-.5 0-.2-.6-1.6-.9-2.2-.2-.5-.4-.5-.6-.5h-.5c-.2 0-.5.1-.7.3-.3.3-.9.9-.9 2.2 0 1.3.9 2.6 1.1 2.8.1.2 1.9 3 4.7 4.2 1.8.7 2.5.8 3.3.6.5-.1 1.7-.7 1.9-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.5-.3Z"/>
      </svg>
      <span class="hidden sm:inline">WhatsApp</span>
      <span class="sm:hidden">Chamar</span>
    </a>
  </div>

  <!-- Nav mobile -->
  <nav aria-label="Menu principal mobile" class="border-t border-primary-100 bg-white md:hidden">
    <ul class="mx-auto flex max-w-6xl items-center justify-around px-4">
      {siteConfig.nav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "inline-flex min-h-11 items-center px-3 py-2 text-sm font-medium",
              currentPath === item.href
                ? "text-primary-900 underline underline-offset-4"
                : "text-slate-700"
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
