---
import { siteConfig } from '../config/siteConfig';

interface Props {
  cidade?: string;
}

const { cidade } = Astro.props;

const enderecoBusca = `${siteConfig.endereco.rua}, ${siteConfig.endereco.bairro}, ${siteConfig.endereco.cidade} ${siteConfig.endereco.estado}`;
const mapsEmbed = `https://www.google.com/maps?q=${encodeURIComponent(enderecoBusca)}&output=embed`;
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(enderecoBusca)}`;
---
<section id="como-encontrar" class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
  <div class="mx-auto max-w-prose text-center">
    <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Como nos encontrar</h2>
    <p class="mt-4 text-base text-slate-700">
      Atendemos presencialmente {cidade ? `${cidade} e região` : 'Campo Grande e toda região metropolitana'}.
      Pode nos visitar ou falar direto no WhatsApp.
    </p>
  </div>

  <div class="mt-10 grid gap-6 md:grid-cols-2">
    <div class="aspect-video overflow-hidden rounded-xl border border-slate-200 shadow-sm">
      <iframe
        src={mapsEmbed}
        title={`Mapa: ${siteConfig.enderecoCompleto}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
        class="h-full w-full border-0"
      ></iframe>
    </div>

    <address class="not-italic">
      <h3 class="text-xl font-semibold text-slate-900">{siteConfig.nome}</h3>
      <dl class="mt-4 space-y-3 text-sm text-slate-700">
        <div class="flex items-start gap-3">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="mt-0.5 h-5 w-5 flex-none text-primary-900">
            <path fill-rule="evenodd" d="M11.5 2a7.5 7.5 0 0 0-7.5 7.5c0 5.9 7 11.8 7.3 12.1a.75.75 0 0 0 .9 0C12.5 21.3 19.5 15.4 19.5 9.5A7.5 7.5 0 0 0 11.5 2Zm.5 10a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z" clip-rule="evenodd"/>
          </svg>
          <div>
            <dt class="font-semibold text-slate-900">Endereço</dt>
            <dd>{siteConfig.endereco.rua} — {siteConfig.endereco.bairro}</dd>
            <dd>{siteConfig.endereco.cidade} — {siteConfig.endereco.estado}, CEP {siteConfig.endereco.cep}</dd>
            <dd class="mt-1">
              <a href={mapsLink} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center font-semibold text-primary-900 underline underline-offset-2 hover:text-primary-800">
                Abrir no Google Maps
              </a>
            </dd>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="mt-0.5 h-5 w-5 flex-none text-primary-900">
            <path d="M20.5 3.5A11 11 0 0 0 3.4 17.3L2 22l4.9-1.3a11 11 0 0 0 16.5-9.5 10.9 10.9 0 0 0-2.9-7.7Z"/>
          </svg>
          <div>
            <dt class="font-semibold text-slate-900">WhatsApp</dt>
            <dd>
              <a href={siteConfig.whatsappLink} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-primary-900 underline underline-offset-2 hover:text-primary-800">
                {siteConfig.whatsapp}
              </a>
            </dd>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="mt-0.5 h-5 w-5 flex-none text-primary-900">
            <path fill-rule="evenodd" d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Zm.75 5.25a.75.75 0 1 0-1.5 0V12c0 .2.08.4.22.53l3 3a.75.75 0 1 0 1.06-1.06l-2.78-2.78V7.25Z" clip-rule="evenodd"/>
          </svg>
          <div>
            <dt class="font-semibold text-slate-900">Horário</dt>
            <dd>Seg a Sex — 08h às 18h</dd>
            <dd>Sáb — 08h às 12h · Emergências 24h via WhatsApp</dd>
          </div>
        </div>
      </dl>
    </address>
  </div>
</section>
