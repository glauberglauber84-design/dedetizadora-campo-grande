---
const posts = [
  { titulo: "Como identificar sinais de cupins em casa", resumo: "Pequenos indícios podem significar colônias inteiras já instaladas.", data: "Em breve" },
  { titulo: "Dedetização pet-friendly: o que esperar", resumo: "O que fazer com cães, gatos e pássaros no dia do serviço.", data: "Em breve" },
  { titulo: "Diferença entre dedetização e desinsetização", resumo: "Entenda qual serviço o seu problema realmente pede.", data: "Em breve" },
  { titulo: "Barreira química: quando vale a pena", resumo: "Preventivo contra cupins em obras e reformas.", data: "Em breve" },
  { titulo: "Ratos em restaurantes: protocolo seguro", resumo: "Controle com segurança alimentar e vigilância sanitária.", data: "Em breve" },
  { titulo: "Pernilongos em Campo Grande: época e cuidados", resumo: "O que fazer nos picos de infestação em MS.", data: "Em breve" }
];
---
<section id="blog" class="bg-slate-50">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-prose text-center">
      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Dicas e novidades</h2>
      <p class="mt-4 text-base text-slate-700">
        Nosso blog traz orientações práticas para proteger sua casa, loja ou empresa.
      </p>
    </div>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <li>
          <article class="flex h-full flex-col rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <span class="inline-flex items-center self-start rounded-full bg-primary-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary-900">
              {post.data}
            </span>
            <h3 class="mt-4 text-xl font-semibold text-slate-900">{post.titulo}</h3>
            <p class="mt-2 flex-1 text-sm text-slate-700">{post.resumo}</p>
            <span class="mt-4 text-sm font-semibold text-slate-700">
              Em preparação
            </span>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>
