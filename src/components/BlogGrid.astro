---
import { getCollection } from 'astro:content';

const todos = await getCollection('artigos', ({ data }) => !data.draft);
const posts = todos
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 6);

const categoriaLabel: Record<string, string> = {
  cupim: 'Cupim',
  baratas: 'Baratas',
  ratos: 'Ratos',
  mosquitos: 'Mosquitos',
  escorpioes: 'Escorpiões',
  formigas: 'Formigas',
  prevencao: 'Prevenção',
  geral: 'Geral',
};

const categoriaImagem: Record<string, string> = {
  cupim: '/images/cupim.jpg',
  baratas: '/images/baratas.jpg',
  ratos: '/images/ratos.jpg',
  escorpioes: '/images/escorpiao.jpg',
  formigas: '/images/formigas.jpg',
  mosquitos: '/images/hero-dedetizacao.jpg',
  prevencao: '/images/hero-dedetizacao.jpg',
  geral: '/images/hero-dedetizacao.jpg',
};

const dateFmt = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
---
<section id="blog" class="bg-slate-50">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-prose text-center">
      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Dicas e novidades</h2>
      <p class="mt-4 text-base text-slate-700">
        Guias práticos escritos pela nossa equipe técnica — do que o morador faz sozinho ao que precisa de técnico.
      </p>
    </div>

    {posts.length === 0 ? (
      <p class="mt-10 text-center text-base text-slate-600">Primeiros artigos chegando em breve.</p>
    ) : (
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <li>
            <a
              href={`/conteudo/${post.slug}`}
              class="flex h-full flex-col overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm transition duration-200 ease-out hover:-translate-y-0.5 hover:border-primary-300 hover:shadow-md motion-reduce:transform-none"
            >
              <img
                src={categoriaImagem[post.data.categoria]}
                alt={`${categoriaLabel[post.data.categoria]} — ${post.data.title}`}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover"
              />
              <div class="flex flex-1 flex-col p-5">
                <span class="inline-flex w-fit items-center rounded-full bg-primary-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary-900">
                  {categoriaLabel[post.data.categoria]}
                </span>
                <h3 class="mt-3 text-lg font-semibold text-slate-900">{post.data.title}</h3>
                <p class="mt-2 flex-1 text-sm text-slate-700">{post.data.description}</p>
                <div class="mt-4 flex items-center justify-between text-xs text-slate-500">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {dateFmt.format(post.data.pubDate)}
                  </time>
                  <span class="inline-flex items-center font-semibold text-primary-900">
                    Ler artigo
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="ml-1 h-4 w-4" aria-hidden="true">
                      <path d="M9 6l6 6-6 6V6z"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}

    {posts.length > 0 && (
      <div class="mt-10 text-center">
        <a
          href="/conteudo"
          class="inline-flex min-h-11 items-center gap-2 rounded-md border-2 border-primary-900 px-5 py-3 text-sm font-semibold text-primary-900 transition hover:bg-primary-900 hover:text-white"
        >
          Ver todos os artigos
        </a>
      </div>
    )}
  </div>
</section>
